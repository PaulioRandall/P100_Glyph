{
	"name": "P100_Glyph",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "20"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/P100_Glyph.git"
	},
	"scripts": {
		"clean": "rm -rf .svelte-kit",
		"fmt": "prettier --log-level warn --write .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testPathPatterns ./src/",
		"build": "npm run fmt && vite build",
		"dev": "npm run fmt && vite dev --port 3000",
		"preview": "npm run build && vite preview --port 4000",
		"commit": "npm run build && cat ./ready-to-ship.txt"
	},
	"devDependencies": {
		"@paulio/p69-svelte": "1.0.0-rc-3",
		"@paulio/p69-util": "1.0.0-rc-2",
		"@sveltejs/adapter-auto": "7.0.0",
		"@sveltejs/kit": "2.49.1",
		"jest": "30.2.0",
		"jest-environment-jsdom": "30.2.0",
		"prettier": "3.7.4",
		"svelte": "5.45.6",
		"two.js": "0.8.22",
		"vite": "7.2.6"
	}
}
